<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>saveModifiedFiles</string>
	<key>command</key>
	<string>#!/bin/bash
. "$TM_BUNDLE_SUPPORT/lib/elixir_commands.sh"

# An untitled document runs as a script.
if [[ -z "${TM_FILEPATH:-}" ]]; then
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/textmate-elixir.XXXXXX") || exit 1
	trap 'rm -rf "$tmp"' EXIT
	cat &gt; "$tmp/untitled.exs"
	elixir_html "${TM_PROJECT_DIRECTORY:-$tmp}" "Run" "elixir untitled.exs" "0:success:Done." elixir "$tmp/untitled.exs"
fi

# Outside a Mix project, a file runs as a script. In a project, a test file (or
# the test of a file in lib) runs its tests, and a script runs in the project.
MIX_ROOT=$(elixir_mix_root) || elixir_html "$TM_DIRECTORY" "Run" "" "0:success:Done." elixir "$TM_FILENAME"

if test=$(elixir_test_file); then
	elixir_html "$MIX_ROOT" "Run Tests" "" "$ELIXIR_TEST_STATUSES" mix test "$test"
fi

file=${TM_FILEPATH#"$MIX_ROOT"/}
case "$file" in
	*.exs)    elixir_html "$MIX_ROOT" "Run" "" "0:success:Done." mix run "$file" ;;
	lib/*.ex) test="test/${file#lib/}"; elixir_exit_tool_tip "There is no test for $file (${test%.ex}_test.exs)." ;;
	*)        elixir_exit_tool_tip "Run runs scripts and tests, and the test of a file in lib." ;;
esac
</string>
	<key>input</key>
	<string>document</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>@r</string>
	<key>name</key>
	<string>Run</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>html</string>
	<key>outputLocation</key>
	<string>newWindow</string>
	<key>scope</key>
	<string>source.elixir</string>
	<key>uuid</key>
	<string>06E4B9F0-06CD-4B95-822F-2CC67E3802C2</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
