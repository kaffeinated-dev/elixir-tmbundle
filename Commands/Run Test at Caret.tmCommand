<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>saveModifiedFiles</string>
	<key>command</key>
	<string>#!/bin/bash
. "$TM_BUNDLE_SUPPORT/lib/elixir_commands.sh"
elixir_require_mix_root

[[ "${TM_FILEPATH:-}" == *_test.exs ]] || elixir_exit_tool_tip "Not a test file (tests are in files ending in _test.exs)."
elixir_html "$MIX_ROOT" "Run Test at Caret" "" "$ELIXIR_TEST_STATUSES" mix test "${TM_FILEPATH#"$MIX_ROOT"/}:$TM_LINE_NUMBER"
</string>
	<key>input</key>
	<string>none</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>@R</string>
	<key>name</key>
	<string>Run Test at Caret</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>html</string>
	<key>outputLocation</key>
	<string>newWindow</string>
	<key>scope</key>
	<string>source.elixir</string>
	<key>uuid</key>
	<string>CE857198-BBB1-4AF2-AA99-87740503390F</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
