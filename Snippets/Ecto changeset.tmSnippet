<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>content</key>
	<string>def changeset(${1:struct}, attrs) do
	$1
	|&gt; cast(attrs, [${2::name}])
	|&gt; validate_required([$2])$0
end</string>
	<key>name</key>
	<string>Ecto changeset</string>
	<key>scope</key>
	<string>source.elixir - string - comment - (text.html - text.html source.elixir)</string>
	<key>tabTrigger</key>
	<string>changeset</string>
	<key>uuid</key>
	<string>5D402B6F-6ACD-4483-B752-10A1B31421F1</string>
</dict>
</plist>
