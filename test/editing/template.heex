<.header>
  Listing users
  <:actions>
    <.link navigate={~p"/users/new"}>
      New user
    </.link>
  </:actions>
</.header>

<.table
  id="users"
  rows={@streams.users}
  row_click={fn {_id, user} -> JS.navigate(~p"/users/#{user}") end}
>
  <:col :let={{_id, user}} label="Name">{user.name}</:col>
</.table>

<%= if @admin do %>
  <p>Admin</p>
<% else %>
  <p>Guest</p>
<% end %>

<ul>
  <li :for={user <- @users}>
    <img src={user.avatar} />
    <span>{user.name}</span>
  </li>
</ul>
